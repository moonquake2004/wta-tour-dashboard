{
  "name": "wta-tour-dashboard",
  "version": "1.0.0",
  "private": true,
  "description": "An independent, open-source data dashboard for the Hologic WTA Tour, built from the official WTA public data feed.",
  "keywords": [
    "wta",
    "tennis",
    "dashboard",
    "rankings",
    "sports-data",
    "static-site"
  ],
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:light": "node scripts/build.mjs --skip-players --skip-matches",
    "refresh": "node scripts/refresh-rankings.mjs",
    "data": "node scripts/generate-data.mjs",
    "site": "node scripts/build-site.mjs",
    "serve": "node scripts/serve.mjs",
    "verify": "node scripts/verify.mjs && node scripts/verify-dashboard.mjs",
    "publish": "node scripts/generate-data.mjs && node scripts/build-site.mjs && node scripts/verify-dashboard.mjs"
  }
}
